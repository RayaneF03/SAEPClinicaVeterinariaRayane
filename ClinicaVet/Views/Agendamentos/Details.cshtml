@model ClinicaVet.Models.Agendamento
@{ ViewData["Title"] = "Detalhes do agendamento"; }
<h1>Detalhes do agendamento</h1><dl class="row"><dt class="col-sm-3">Data e hora</dt><dd class="col-sm-9">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-sm-3">Serviço</dt><dd class="col-sm-9">@Model.Servico</dd><dt class="col-sm-3">Pet</dt><dd class="col-sm-9">@Model.Pet?.Nome</dd><dt class="col-sm-3">Tutor</dt><dd class="col-sm-9">@Model.Pet?.Tutor?.Nome</dd></dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> <a class="btn btn-secondary" asp-action="Index">Voltar</a>
