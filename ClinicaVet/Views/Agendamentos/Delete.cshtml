@model ClinicaVet.Models.Agendamento
@{ ViewData["Title"] = "Excluir agendamento"; }
<h1>Excluir agendamento</h1><p>Confirma a exclusão do agendamento de <strong>@Model.Pet?.Nome</strong>?</p>
<form method="post"><input asp-for="Id" type="hidden" /><button class="btn btn-danger">Excluir</button> <a class="btn btn-secondary" asp-action="Index">Cancelar</a></form>
