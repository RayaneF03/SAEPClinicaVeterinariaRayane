@model ClinicaVet.Models.Agendamento
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Id" type="hidden" />
<div class="mb-3"><label asp-for="DataHora"></label><input asp-for="DataHora" class="form-control" type="datetime-local" /></div><div class="mb-3"><label asp-for="Servico"></label><input asp-for="Servico" class="form-control" /></div><div class="mb-3"><label asp-for="PetId">Pet</label><select asp-for="PetId" asp-items="ViewBag.PetId" class="form-select"><option value="">Selecione</option></select></div>
<button class="btn btn-primary">Salvar</button> <a class="btn btn-secondary" asp-action="Index">Cancelar</a></form>
