@model ClinicaVet.Models.Pet
<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Id" type="hidden" />
<div class="mb-3"><label asp-for="Nome"></label><input asp-for="Nome" class="form-control" /></div><div class="mb-3"><label asp-for="Especie"></label><input asp-for="Especie" class="form-control" /></div><div class="mb-3"><label asp-for="DataNascimento"></label><input asp-for="DataNascimento" class="form-control" type="date" /></div><div class="mb-3"><label asp-for="TutorId">Tutor</label><select asp-for="TutorId" asp-items="ViewBag.TutorId" class="form-select"><option value="">Selecione</option></select><span asp-validation-for="TutorId" class="text-danger"></span></div>
<button class="btn btn-primary">Salvar</button> <a class="btn btn-secondary" asp-action="Index">Cancelar</a></form>
