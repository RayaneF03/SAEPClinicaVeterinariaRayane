@model ClinicaVet.Models.Tutor
@{ ViewData["Title"] = "Detalhes do tutor"; }
<h1>Detalhes do tutor</h1><dl class="row"><dt class="col-sm-3">Nome</dt><dd class="col-sm-9">@Model.Nome</dd><dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Telefone</dt><dd class="col-sm-9">@Model.Telefone</dd></dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> <a class="btn btn-secondary" asp-action="Index">Voltar</a>
